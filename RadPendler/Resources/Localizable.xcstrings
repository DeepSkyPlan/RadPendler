            "state": "translated",
            "value": "Transitous: unexpected response"
          }
        }
      }
    },
    "Tür zu Tür, mit Ampeln und Halten — damit wird die Fahrzeit gerechnet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Door to door, traffic lights and stops included — this is what the travel time is based on"
          }
        }
      }
    },
