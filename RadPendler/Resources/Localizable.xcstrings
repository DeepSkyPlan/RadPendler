            "value": "Lines seen so far"
          }
        }
      }
    },
    "Gilt nur für %@ ↔ %@, in beiden Richtungen. Radrouten fahren die Fixpunkte an, die am Weg liegen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to %@ ↔ %@, in both directions. Bike routes ride through the fixed points that lie on the way."
