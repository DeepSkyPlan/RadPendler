    "Fixpunkt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed point"
          }
        }
      }
    },
    "Fixpunkt hinzufügen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a fixed point"
          }
