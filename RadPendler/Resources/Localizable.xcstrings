    "Tippen, um zu suchen. Was einmal gewählt wurde, steht beim nächsten Mal oben — je öfter benutzt, desto weiter oben.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to search. Whatever you picked once is at the top next time — the more often used, the further up."
          }
        }
      }
    },
    "Transitous: unerwartete Antwort": {
      "extractionState": "manual",
      "localizations": {
