      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Car"
          }
        }
      }
    },
    "Automatik an — die Fahrt hält bei langem Stehen von selbst an": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic on — the ride pauses by itself when you stand for long"
          }
        }
      }
    },
    "Automatik aus — die Fahrt hält nicht von selbst an": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic off — the ride will not pause by itself"
          }
        }
      }
    },
